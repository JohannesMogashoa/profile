---
import type { CollectionEntry } from "astro:content";
import ArticleCard from "./ArticleCard.astro";
import Section from "./Section.astro";
import SectionTitle from "./SectionTitle.astro";

interface Props {
	articles: CollectionEntry<"articles">[];
}

const { articles } = Astro.props;
---

<Section id="articles" class="articles-section">
	<div class="section-heading section-heading--split">
		<div>
			<p class="eyebrow">
				<span></span> Writing
			</p>
			<SectionTitle>Notes from the workbench.</SectionTitle>
		</div>
		<p>Practical lessons about .NET, TypeScript, product engineering, and the mistakes between.</p>
	</div>
	<div class="card-grid">
		{articles.length === 0 ? (
			<p class="section-text section-text--empty">
				Articles are temporarily unavailable. Please check back soon.
			</p>
		) : (
			articles.slice(0, 3).map(({ data: article }) => <ArticleCard {article} />)
		)}
	</div>
</Section>
