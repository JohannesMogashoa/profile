---
import Section from "./Section.astro";
import SectionDivider from "./SectionDivider.astro";
import SectionTitle from "./SectionTitle.astro";
import { projects } from "../data/portfolio.js";
---

<Section id="projects" nopadding>
	<SectionDivider />
	<SectionTitle main>Projects</SectionTitle>
	<div class="card-grid">
		{projects.length === 0 ? (
			<p class="section-text section-text--empty">Still in the pipeline or fighting some bugs...</p>
		) : (
			projects.map((project) => (
				<article class="portfolio-card">
					{project.image && <img src={project.image} alt={project.title} loading="lazy" />}
					<div class="card-title"><h3>{project.title}</h3><hr /></div>
					<p class="card-info">{project.description}</p>
					<div>
						<div class="card-label">Stack</div>
						<ul class="tag-list">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
					</div>
					<ul class="card-links">
						<li><a href={project.code}>Code</a></li>
						<li><a href={project.source}>Source</a></li>
					</ul>
				</article>
			))
		)}
	</div>
</Section>
