---
import Icon from "./Icon.astro";
---

<header class="site-header">
	<div class="site-header__brand">
		<a href="/" class="brand-link" aria-label="Kode Stallion home">
			<Icon name="brand" size={30} />
			<span>Kode Stallion</span>
		</a>
	</div>

	<nav class="site-header__nav" aria-label="Primary navigation">
		<a href="#about">About</a>
		<a href="#articles">Articles</a>
		<a href="#tech">Technologies</a>
	</nav>

	<div class="site-header__socials" aria-label="Social links">
		<a
			href="https://www.github.com/JohannesMogashoa"
			aria-label="GitHub"
			target="_blank"
			rel="noreferrer"
		>
			<Icon name="github" size={30} />
		</a>
		<a
			href="https://www.linkedin.com/in/johannes-mogashoa-358416190"
			aria-label="LinkedIn"
			target="_blank"
			rel="noreferrer"
		>
			<Icon name="linkedin" size={30} />
		</a>
	</div>
</header>
