---
import Icon from "./Icon.astro";
import ButtonLink from "./ButtonLink.astro";
---

<footer class="site-footer" id="contact">
	<div class="contact-panel">
		<p class="eyebrow">
			<span></span> Let’s build clearly
		</p>
		<h2>Have a difficult software problem?</h2>
		<p>Bring the context. I’ll bring an engineering perspective grounded in delivery.</p>
		<ButtonLink href="mailto:yngstln.dev@gmail.com">
			Start a conversation <span>↗</span>
		</ButtonLink>
	</div>

	<div class="site-footer__bottom">
		<a href="/" class="brand-link" aria-label="Johannes Mogashoa home">
			<span class="brand-link__mark">
				<Icon name="brand" size={20} />
			</span>
			<span>Johannes Mogashoa</span>
		</a>
		<p>Software engineer · Johannesburg, South Africa</p>
		<div class="site-footer__socials" aria-label="Social links">
			<a
				href="https://www.github.com/JohannesMogashoa"
				aria-label="GitHub"
				target="_blank"
				rel="noreferrer"
			>
				<Icon name="github" size={22} />
			</a>
			<a
				href="https://www.linkedin.com/in/johannes-mogashoa-358416190"
				aria-label="LinkedIn"
				target="_blank"
				rel="noreferrer"
			>
				<Icon name="linkedin" size={22} />
			</a>
		</div>
	</div>
</footer>
