---
interface Props {
	id?: string;
	grid?: boolean;
	nopadding?: boolean;
	class?: string;
}

const { id, grid = false, nopadding = false, class: className = "" } = Astro.props;
---

<section
	id={id}
	class:list={["section", { "section--grid": grid, "section--nopadding": nopadding }, className]}
>
	<slot />
</section>
