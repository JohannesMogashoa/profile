---
type IconName = "backend" | "brand" | "cloud" | "frontend" | "github" | "linkedin";

interface Props {
	name: IconName;
	size?: number;
}

const { name, size = 24 } = Astro.props;

const paths: Record<IconName, string[]> = {
	backend: [
		"M4 6c0-1.1 3.6-2 8-2s8 .9 8 2-3.6 2-8 2-8-.9-8-2Zm0 0v6c0 1.1 3.6 2 8 2s8-.9 8-2V6M4 12v6c0 1.1 3.6 2 8 2s8-.9 8-2v-6",
	],
	brand: ["m8 9-4 3 4 3", "m16 9 4 3-4 3", "m14 6-4 12"],
	cloud: ["M17.5 19H7a5 5 0 1 1 1.7-9.7A6 6 0 0 1 20 12a3.5 3.5 0 0 1-2.5 7Z", "m9 15 2 2 4-4"],
	frontend: ["M3 5h18v14H3z", "m8 10-2 2 2 2", "m16 10 2 2-2 2", "m14 8-4 8"],
	github: [
		"M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.15-1.11-1.46-1.11-1.46-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.56 9.56 0 0 1 12 6.8c.85 0 1.71.11 2.51.34 1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.79c0 .27.18.58.69.48A10 10 0 0 0 12 2Z",
	],
	linkedin: [
		"M6.5 8.5H3.2V19h3.3V8.5ZM4.85 3A1.92 1.92 0 1 0 4.8 6.84 1.92 1.92 0 0 0 4.85 3ZM9 8.5V19h3.3v-5.2c0-1.37.26-2.7 1.96-2.7 1.68 0 1.7 1.57 1.7 2.8V19h3.3v-5.75c0-2.82-.61-4.99-3.9-4.99-1.58 0-2.64.87-3.07 1.69h-.04V8.5H9Z",
	],
};
---

<svg
	aria-hidden="true"
	fill={name === "github" || name === "linkedin" ? "currentColor" : "none"}
	height={size}
	viewBox="0 0 24 24"
	width={size}
	xmlns="http://www.w3.org/2000/svg"
>
	{paths[name].map((path) => (
		<path
			d={path}
			fill={name === "github" || name === "linkedin" ? "currentColor" : "none"}
			stroke={name === "github" || name === "linkedin" ? "none" : "currentColor"}
			stroke-linecap="round"
			stroke-linejoin="round"
			stroke-width="1.8"
		/>
	))}
</svg>
